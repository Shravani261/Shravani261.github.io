# Copy to .env
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./portfolio.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/portfolio
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portfolio

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Token required for admin endpoints (create/update/delete + reading messages)
ADMIN_TOKEN=Shravani